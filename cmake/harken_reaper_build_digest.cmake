if(NOT EXISTS "${INPUT}" OR "${OUTPUT}" STREQUAL "")
    message(FATAL_ERROR "REAPER build digest needs the built component and output header")
endif()
file(SHA256 "${INPUT}" digest)
string(LENGTH "${digest}" digest_length)
if(NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Cannot pin the REAPER component SHA-256")
endif()
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT}.tmp" "#pragma once\n#define HARKEN_MAC_REAPER_BUILD_SHA256 \"${digest}\"\n")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
file(REMOVE "${OUTPUT}.tmp")

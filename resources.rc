// Harken Search Windows Resource File
// Application icon resource

// Use numeric ID 1 for main application icon
1 ICON "HarkenSearch.ico"


1 VERSIONINFO
 FILEVERSION 1,0,41,0
 PRODUCTVERSION 1,0,41,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Harken Search"
            VALUE "FileVersion", "1.0.41"
            VALUE "InternalName", "HarkenSearch"
            VALUE "OriginalFilename", "HarkenSearch.exe"
            VALUE "ProductName", "Harken Search"
            VALUE "ProductVersion", "1.0.41"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
